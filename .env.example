# FESTIVA environment variables
# Copy to .env.local for local development. Never commit real values.
# Every variable is OPTIONAL. With none set, FESTIVA runs in an honest demo mode:
# on-device storage, demo share links, and a rules-based Matchmaker and assistant.

# --- Site -------------------------------------------------------------------
# Public base URL, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (accounts, cloud plans, durable share links, analytics) --------
# Both must be set together. The anon key is safe to expose: Row Level Security
# in supabase/migrations protects the data. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI (server-side only; never prefix these with NEXT_PUBLIC_) -------------
# Set ONE provider key. Without a key, Intelligence answers from the curated
# guide and the Matchmaker uses its built-in rules.
# AI_PROVIDER=anthropic            # or: openai (optional; inferred from the key)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=                        # optional override of the default model
# AI_TIMEOUT_MS=12000              # 1000 to 60000

# =============================================================================
# Gift Circle and sponsor integrations. All optional; every one has an honest
# "Not configured" state. Full details (where each value comes from, rotation,
# how to disable): docs/SPONSORS.md. All of these are SERVER-ONLY secrets:
# never prefix them with NEXT_PUBLIC_.
# =============================================================================

# --- FESTIVA server ----------------------------------------------------------
# Where Gift Circle data, integration status, alerts and the audit trail live
# (file store). Default: ./.festiva-data. Use a persistent volume in production.
# FESTIVA_DATA_DIR=
# file (default; one server instance) or supabase (apply supabase/migrations
# first; needs NEXT_PUBLIC_SUPABASE_URL and the service-role key below).
# FESTIVA_CIRCLE_STORE=file
# SUPABASE_SERVICE_ROLE_KEY=        # server-only; only used for the gift_circles table
# Opens /admin/integrations and /admin/operations. At least 24 random characters,
# e.g. `openssl rand -base64 32`. Without it, admin pages are closed to everyone.
# FESTIVA_ADMIN_TOKEN=
# Bearer token for Prometheus to scrape /api/ops/metrics (24+ characters).
# FESTIVA_METRICS_TOKEN=
# Bearer token a NudgeBee workflow uses to PROPOSE a runbook (never run one).
# FESTIVA_OPS_WEBHOOK_TOKEN=
# How to find a visitor's address for rate limiting. vercel = trust x-real-ip
# (set automatically on Vercel); 1 = trust only the last X-Forwarded-For hop,
# added by one reverse proxy you control (default elsewhere); none = ignore
# forwarding headers (no proxy in front of the server).
# FESTIVA_TRUST_PROXY=

# --- Sarvam AI (voice, translation, structuring) -----------------------------
# From dashboard.sarvam.ai. Sent only from the server, in the api-subscription-key header.
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4        # or saaras:v3
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TIMEOUT_MS=20000           # 2000 to 60000
# SARVAM_API_URL=                   # leave empty for https://api.sarvam.ai

# --- Flagsmith (feature flags, remote configuration, experiment) -------------
# Environment Settings > Keys in Flagsmith. Prefer the SERVER-SIDE key (ser.…):
# it enables local evaluation, refreshed every FLAGSMITH_REFRESH_SECONDS.
# FLAGSMITH_ENVIRONMENT_KEY=
# FLAGSMITH_REFRESH_SECONDS=15      # 5 to 600
# FLAGSMITH_ENABLE_EVENTS=false     # true: send experiment exposures/conversions to Flagsmith
# FLAGSMITH_API_URL=                # only for self-hosted Flagsmith (…/api/v1/)
# FLAGSMITH_OFFLINE_ENVIRONMENT_FILE=   # tests/air-gapped only: evaluate a saved environment document

# --- NudgeBee (operations intelligence) --------------------------------------
# NudgeBee: Admin > Integrations > Webhooks > Event Webhook. Copy the URL
# (…/api/webhooks/event) and put its token here, not in the URL.
# NUDGEBEE_EVENT_WEBHOOK_URL=
# NUDGEBEE_EVENT_WEBHOOK_TOKEN=
# Optional, read-only: a Platform API token (sk-nb-…) limited to Events.
# NUDGEBEE_API_URL=                 # e.g. https://app.nudgebee.com
# NUDGEBEE_API_TOKEN=
# NUDGEBEE_APP_URL=                 # link shown in the admin pages; defaults to NUDGEBEE_API_URL

# --- Amazon (Shop, optional) ---------------------------------------------------
# Without these, each gift idea links to Amazon's own search results with no affiliate tag.
# AMAZON_ASSOCIATE_TAG=             # your Amazon Associates tag; links then say they are affiliate links
# AMAZON_MARKETPLACE=amazon.in      # amazon.in, amazon.com, amazon.co.uk, amazon.de, amazon.co.jp or amazon.com.au
# AMAZON_PAAPI_ACCESS_KEY=          # Product Advertising API 5.0, reserved for live product data (not shown yet)
# AMAZON_PAAPI_SECRET_KEY=
